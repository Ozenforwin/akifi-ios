    "NSCameraUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akifi uses the camera to scan receipts and automatically create transactions"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akifi usa la cámara para escanear recibos y crear transacciones automáticamente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akifi использует камеру, чтобы сканировать чеки и автоматически создавать операции"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akifi uses your microphone for voice messages with the AI financial assistant"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akifi usa el micrófono para los mensajes de voz al asistente financiero con IA"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akifi использует микрофон для голосовых сообщений финансовому ИИ-ассистенту"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akifi needs access to your photos to set a profile picture, attach photos to notes or scan receipts"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akifi necesita acceso a tus fotos para poner una foto de perfil, adjuntar fotos a las notas o escanear recibos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akifi нужен доступ к фото, чтобы поставить фото профиля, прикрепить снимки к заметкам или распознать чек"
          }
        }
      }
    }
  },
  "version" : "1.0"
